# 电力配网抢修工单系统 本地编排变量
# 复制为 .env 后执行 docker compose up -d

# Compose 项目名与容器名前缀
COMPOSE_PROJECT_NAME=grid-repair

# 宿主机端口映射
FRONTEND_PORT=20104
BACKEND_PORT=21104
DB_PORT=33060

# MySQL 8.0 凭据（容器内库监听 3306）
DB_NAME=app_db
DB_USER=app_user
DB_PASSWORD=app_password

# JWT 密钥（本地演示用，生产请替换）
JWT_SECRET=local-dev-secret
